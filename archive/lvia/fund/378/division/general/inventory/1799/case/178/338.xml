    <profileDesc>
      <abstract><p>
        Ответ <persName ref="Палкин">Палкина</persName> Надворному суду о наличии среди <placeName ref="Вильна">виленских</placeName>
        жителей евреев с именами и отчествами <persName ref="Лейба_Рафалович">Лейба Рафалович</persName> и <persName>Лейба
        Давыдович</persName>
      </p></abstract>
      <creation><date when="1800-01-16">16 января 1800 года</date></creation>
    </profileDesc>
  </teiHeader>
  <text xml:lang="ru"><body>
    <pb n="338-1"/>
    <fw type="docNum" place="left">№ 30</fw>
    <fw type="note">Получено <date when="1800-01-17">17<hi rend="superscript">го</hi> генваря 1800 года</date>.</fw>
    <fw type="pageNum" place="right">338.</fw>
    <fw type="note" place="left margin">ис-</fw>
    <head>
      <l>Въ <orgName ref="Литовский_надворный_суд">Литовской Nадворной судъ</orgName></l>
      <l>отправящаго камендантскую долж-</l>
      <l>ность <placeName ref="Вильна">виленскаго</placeName> плацъ маїора под-</l>
      <l>полковника</l>
    </head>
    <p>
      <l>По послѣдовавшему ко мнѣ</l>
      <l>отъ <date when="1800-01-11">11<hi rend="superscript">го</hi> числа сего мца<note place="end">месяца; над словом
      - титло</note></date> <fw type="docNum">№ 4<hi rend="superscript">м</hi></fw> сообщенію</l>
      <l>чрезъ городовую полицїю чинены выпра:</l>
      <l>вки и оказалось въ домахъ подъ № 233<hi rend="superscript">м</hi></l>
      <l>и 374<hi rend="superscript">м</hi> находются а 205<hi rend="superscript">м</hi> и 607<hi rend="superscript"
      >м</hi> не име-</l>
      <l>ется <persName>лейбовъ довидовичемъ</persName>, под №</l>
      <l>243<hi rend="superscript">м</hi> и 1220<hi rend="superscript">м</hi> <persName ref="Лейба_Рафалович">Лѣйбы Рафаловича</persName> тоже</l>
      <l>находются изъ коихъ первой мало:</l>
      <l>летной а подъ № 345<hi rend="superscript">м</hi> таковаго Рафало:</l>
      <l>вича не оказалось; о чемъ оной <orgName ref="Литовский_надворный_суд">надво-<lb break="no"/>
       рной судъ</orgName> симъ увѣдомляю._</l>
      <l><signed><persName>Плацъ</persName> маиоръ подполковникъ <persName ref="Палкин">Палкинъ</persName></signed></l>
    </p>
    <closer place="left">
      <l><fw type="docNum">№ 33<hi rend="superscript">и</hi></fw></l>
      <l><date when="1800-01-16">16 генваря<lb/>
       1800 года</date></l>
      <l><placeName ref="Вильна">вилна</placeName></l>
    </closer>
    <fw type="note" place="left margin"><choice><abbr>Слуш</abbr><expan>слушано</expan></choice>: <date when="1800-01-23">23<hi
    rend="superscript">го</hi> генваря</date></fw>
